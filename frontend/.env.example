# Copy to .env.local for local development (gitignored). None of these are secrets that grant
# access to anything beyond this demo backend - the application API key itself is entered at
# runtime in the UI and kept only in sessionStorage, never in this file or in built JS.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_DEFAULT_CORPUS_ID=northstar_demo_extended
